                      00135 ;------------------------------------------------------------------------------
                      00136 ; High priority interrupt : Timer0 every 1 ms
                      00137 ;------------------------------------------------------------------------------
00000C                00138 HighInt:
00000C 0005           00139         push                            ; save W, STATUS, BSR
                      00140 
00000E 94F2           00141         bcf     INTCON,TMR0IF
000010 0ED8           00142         movlw   0xD8                    ; reload for 1.000 ms at 40 MHz
000012 6ED7           00143         movwf   TMR0H                   ; 65536 - 10000 = 0xD8F0
000014 0EF0           00144         movlw   0xF0
000016 6ED6           00145         movwf   TMR0L
                      00146 
                      00147         ; ---- 100 ms heartbeat : ask main loop to send a frame ----
000018 2A01           00148         incf    hb_cnt,F
