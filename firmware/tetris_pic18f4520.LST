                      00177 ;------------------------------------------------------------------------------
                      00178 ; scan_keys : called every 10 ms from the Timer0 interrupt
                      00179 ; Two identical samples are needed, so a key is debounced over 20 ms.
                      00180 ; Press edges set action flags. Left / right / soft drop auto-repeat.
                      00181 ;------------------------------------------------------------------------------
000044                00182 scan_keys:
000044 5081           00183         movf    PORTB,W
000046 0B3F           00184         andlw   0x3F                    ; RB0..RB5 only
000048 0A3F           00185         xorlw   0x3F                    ; invert: 1 = pressed
00004A 6E2B           00186         movwf   tmp_raw
                      00187 
00004C 1802           00188         xorwf   key_last,W              ; same as previous sample ?
00004E E003           00189         bz      keys_same
000050 502B           00190         movf    tmp_raw,W               ; new sample, wait for confirmation
000052 6E02           00191         movwf   key_last
000054 0012           00192         return
                      00193 
000056                00194 keys_same:
000056 502B           00195         movf    tmp_raw,W
000058 1803           00196         xorwf   key_stable,W            ; state changed ?
00005A E017           00197         bz      keys_held
                      00198         ; ---- new pressed bits = raw AND (raw XOR stable) ----
00005C 502B           00199         movf    tmp_raw,W
00005E 1803           00200         xorwf   key_stable,W
000060 142B           00201         andwf   tmp_raw,W
