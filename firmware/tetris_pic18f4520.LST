                      00001 ;==============================================================================
                      00002 ;  File    : tetris_pic18f4520.asm
                      00003 ;  Project : 2026 Microprocessor Final Project - Tetris (UART version)
                      00004 ;  Target  : PIC18F4520, 10 MHz crystal, HSPLL -> Fosc = 40 MHz
                      00005 ;  Tool    : MPLAB X IDE v5.20 + MPASM (absolute code, no linker needed)
                      00006 ;
                      00007 ;  Hardware
                      00008 ;    RB0..RB5 : active-low push buttons with internal pull-ups
                      00009 ;               RB0 = left, RB1 = right, RB2 = soft drop
                      00010 ;               RB3 = hard drop, RB4 = rotate, RB5 = pause / restart
                      00011 ;    RC6/TX   : UART TX -> USB-TTL module RXD (115200, 8N1)
                      00012 ;    RC7/RX   : UART RX (not used by the game, keep connected or open)
                      00013 ;    Timer0   : 1 ms interrupt, used for key debounce and gravity timing
                      00014 ;
                      00015 ;  UART frame (fixed 208 bytes, little endian for score)
                      00016 ;    [0]      0xA5          start byte 1
                      00017 ;    [1]      0x5A          start byte 2
                      00018 ;    [2..201] board         10 columns x 20 rows
                      00019 ;                           byte value 0 = empty, 1 = fixed block, 2 = active
                      00020 ;    [202]    score high
                      00021 ;    [203]    score low
                      00022 ;    [204]    lines
                      00023 ;    [205]    level
                      00024 ;    [206]    state : 0 = running, 1 = paused, 2 = game over
                      00025 ;    [207]    checksum : XOR of byte 0 .. byte 206
                      00026 ;
                      00027 ;  Board layout : index = row * 10 + column, row 0 = top, row 19 = bottom
                      00028 ;  Piece table  : 7 pieces x 4 rotations x 4 rows, row mask bit0 = column 0
                      00029 ;==============================================================================
                      00030 
                      00031         LIST    P=18F4520
                      00032         #include <P18F4520.INC>
                      00001         LIST
                      00002 
